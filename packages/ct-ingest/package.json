{
  "name": "@webnotary/ct-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "webnotary-ct-ingest": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:deps && tsc -p tsconfig.build.json && chmod +x dist/cli.js && npm run build:lambda",
    "build:deps": "npm run build --prefix ../data-model",
    "build:lambda": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/handler.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@webnotary/data-model": "file:../data-model"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
