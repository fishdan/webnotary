{
  "name": "@webnotary/lookup-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:deps && esbuild src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/handler.js",
    "build:deps": "npm run build --prefix ../data-model && npm run build --prefix ../trust-policy && npm run build --prefix ../observer",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && cd dist && zip -q handler.zip handler.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@webnotary/data-model": "file:../data-model",
    "@webnotary/observer": "file:../observer",
    "@webnotary/trust-policy": "file:../trust-policy"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
